<%@ page pageEncoding="UTF-8" %>
<aside class="lab-sidebar">
    <div class="lab-brand">
        <span class="lab-brand-icon"><i class="bi bi-droplet-half"></i></span>
        <div>
            <strong>DiabetesCare</strong>
            <small>Phòng xét nghiệm</small>
        </div>
    </div>

    <div class="lab-user">
        <div class="lab-avatar">${sessionScope.currentUser.fullName.charAt(0)}</div>
        <div>
            <strong>${sessionScope.currentUser.fullName}</strong>
            <small>${sessionScope.currentUser.email}</small>
        </div>
    </div>

    <nav class="lab-nav">
        <a class="active" href="${pageContext.request.contextPath}/doctor-lab/dashboard">
            <i class="bi bi-grid-1x2"></i> Tổng quan xét nghiệm
        </a>
        <a href="#request-list">
            <i class="bi bi-clipboard2-pulse"></i> Danh sách yêu cầu
        </a>
        <a href="#completed-list">
            <i class="bi bi-clock-history"></i> Lịch sử hoàn thành
        </a>
        <a href="${pageContext.request.contextPath}/settings">
            <i class="bi bi-gear"></i> Cài đặt
        </a>
    </nav>

    <div class="lab-sidebar-footer">
        <a href="${pageContext.request.contextPath}/logout">
            <i class="bi bi-box-arrow-right"></i> Đăng xuất
        </a>
    </div>
</aside>
