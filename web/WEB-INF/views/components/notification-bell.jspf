<%@ page pageEncoding="UTF-8" %>
<div class="notification-center" data-notification-center data-context-path="${pageContext.request.contextPath}">
    <button type="button" class="notification-trigger" data-notification-trigger aria-label="Thông báo" aria-expanded="false">
        <i class="bi bi-bell"></i>
        <span class="notification-label">Thông báo</span>
        <span class="notification-badge${empty unreadNotificationCount or unreadNotificationCount == 0 ? ' is-hidden' : ''}" data-notification-badge>${empty unreadNotificationCount ? 0 : unreadNotificationCount}</span>
    </button>
    <div class="notification-dropdown" data-notification-dropdown hidden>
        <div class="notification-dropdown-header">
            <strong>Thông báo gần đây</strong>
            <button type="button" class="notification-close" data-notification-close aria-label="Đóng">&times;</button>
        </div>
        <div class="notification-list" data-notification-list>
            <p class="notification-empty">Chưa tải thông báo.</p>
        </div>
        <a class="notification-view-all" href="${pageContext.request.contextPath}/notifications/page">Xem tất cả thông báo</a>
    </div>
</div>
<script defer src="${pageContext.request.contextPath}/assets/js/components/notification-bell.js?v=20260715-notification2"></script>

