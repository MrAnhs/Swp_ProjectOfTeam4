<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>

<aside class="sidebar-modern">
    <div class="sidebar-header">
        <a href="${pageContext.request.contextPath}/patient/dashboard" class="brand-dashboard">
            <div class="brand-icon-dash">
                <i class="bi bi-heart-pulse-fill"></i>
            </div>
            <span class="brand-text">DiabetesCare</span>
        </a>
    </div>

    <!-- Unified Emerald Dark Profile Card -->
    <div class="user-profile-sidebar-card" style="cursor: pointer; display: flex !important; flex-direction: column !important; align-items: stretch !important; margin: 12px; padding: 12px 14px; border-radius: 14px; background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.25); transition: all 0.25s ease;" onclick="openGlobalEditProfileModal()" role="button" tabindex="0" title="Nhấn để chỉnh sửa thông tin cá nhân">
        <div class="d-flex align-items-center gap-3 mb-2">
            <div class="user-avatar" style="width: 40px; height: 40px; border-radius: 50%; background: #10b981; color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.05rem; flex-shrink: 0; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.35);">
                <c:out value="${fn:substring(sessionScope.currentUser.fullName,0,1)}" default="P" />
            </div>
            <div class="user-info" style="min-width: 0; flex: 1;">
                <h6 class="mb-0 fw-bold" style="font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-primary, #1a202c);"><c:out value="${sessionScope.currentUser.fullName}"/></h6>
                <span class="badge px-2 py-1 mt-1" style="font-size: 0.65rem; font-family: monospace; background: rgba(16, 185, 129, 0.2); color: #007f61; border: 1px solid rgba(16, 185, 129, 0.35);">PATIENT SYSTEM</span>
            </div>
        </div>
        <div class="d-flex align-items-center justify-content-between pt-2 mt-1 border-top border-secondary border-opacity-25" style="font-size: 0.76rem;">
            <span class="fw-semibold d-flex align-items-center gap-1" style="color: #34d399 !important;"><i class="bi bi-check-circle-fill"></i> Hồ sơ hoàn tất</span>
            <span class="fw-semibold d-flex align-items-center gap-1" style="color: #38bdf8 !important;"><i class="bi bi-pencil-square"></i> Chỉnh sửa</span>
        </div>
    </div>

    <nav class="sidebar-nav">
        <a href="${pageContext.request.contextPath}/patient/dashboard"
           class="nav-item-dash${activePatientPage eq 'dashboard' ? ' active' : ''}">
            <i class="bi bi-grid-1x2"></i>
            <span class="nav-text">Tổng quan</span>
        </a>
        <a href="${pageContext.request.contextPath}/patient/appointments/new"
           class="nav-item-dash${activePatientPage eq 'book-appointment' ? ' active' : ''}">
            <i class="bi bi-calendar-plus"></i>
            <span class="nav-text">Đặt lịch khám</span>
        </a>
        <a href="${pageContext.request.contextPath}/patient/appointments"
           class="nav-item-dash${activePatientPage eq 'appointments' ? ' active' : ''}">
            <i class="bi bi-calendar-check"></i>
            <span class="nav-text">Lịch hẹn của tôi</span>
        </a>
        <a href="${pageContext.request.contextPath}/patient/invoices"
           class="nav-item-dash${activePatientPage eq 'invoices' ? ' active' : ''}">
            <i class="bi bi-receipt"></i>
            <span class="nav-text">Hóa đơn</span>
        </a>
        <a href="${pageContext.request.contextPath}/patient/records"
           class="nav-item-dash${activePatientPage eq 'records' ? ' active' : ''}">
            <i class="bi bi-file-earmark-medical"></i>
            <span class="nav-text">Lịch sử khám</span>
        </a>
        <a href="${pageContext.request.contextPath}/patient/ai-chat"
           class="nav-item-dash${activePatientPage eq 'ai-chat' ? ' active' : ''}">
            <i class="bi bi-robot"></i>
            <span class="nav-text">Chat AI</span>
        </a>
        <a href="${pageContext.request.contextPath}/patient/notifications"
           class="nav-item-dash${activePatientPage eq 'notifications' ? ' active' : ''} d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-bell"></i>
                <span class="nav-text">Thông báo</span>
            </div>
            <c:if test="${not empty unreadNotificationCount and unreadNotificationCount > 0}">
                <span class="badge rounded-pill bg-danger px-2 py-1" style="font-size: 0.72rem; font-weight: 700; box-shadow: 0 2px 6px rgba(220, 38, 38, 0.4);"><c:out value="${unreadNotificationCount}" /></span>
            </c:if>
        </a>
        <a href="${pageContext.request.contextPath}/patient/family-sharing"
           class="nav-item-dash${activePatientPage eq 'family-sharing' ? ' active' : ''}">
            <i class="bi bi-people"></i>
            <span class="nav-text">Hồ sơ gia đình</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <a href="${pageContext.request.contextPath}/logout" class="nav-item-dash text-danger">
            <i class="bi bi-box-arrow-right"></i>
            <span class="nav-text">Đăng xuất</span>
        </a>
    </div>
</aside>

<%@ include file="/WEB-INF/views/components/edit-profile-modal.jspf" %>
