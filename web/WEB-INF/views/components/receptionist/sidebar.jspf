<%@ page pageEncoding="UTF-8" %>
<aside class="receptionist-sidebar">
    <div class="receptionist-brand">
        <div class="brand-icon"><i class="bi bi-headset"></i></div>
        <div>
            <div class="brand-title">DiabetesCare</div>
            <div class="brand-subtitle">Khu vực lễ tân</div>
        </div>
    </div>

    <div class="receptionist-profile">
        <div class="profile-avatar">
            <c:out value="${fn:substring(sessionScope.currentUser.fullName,0,1)}" default="L" />
        </div>
        <div class="profile-info">
            <div class="profile-name"><c:out value="${sessionScope.currentUser.fullName}" default="Lễ tân" /></div>
            <div class="profile-role">Nhân viên lễ tân</div>
        </div>
    </div>

    <nav class="receptionist-nav">
        <a class="nav-link ${currentPage == 'dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/receptionist/dashboard">
            <i class="bi bi-grid-1x2"></i><span>Tổng quan</span>
        </a>
        <a class="nav-link ${currentPage == 'patient-search' ? 'active' : ''}" href="${pageContext.request.contextPath}/receptionist/patients/search">
            <i class="bi bi-search"></i><span>Tìm bệnh nhân</span>
        </a>
        <a class="nav-link ${currentPage == 'patient-register' ? 'active' : ''}" href="${pageContext.request.contextPath}/receptionist/patients/register">
            <i class="bi bi-person-plus"></i><span>Đăng ký bệnh nhân</span>
        </a>
        <a class="nav-link ${currentPage == 'appointment' ? 'active' : ''}" href="${pageContext.request.contextPath}/receptionist/appointments/new">
            <i class="bi bi-calendar2-plus"></i><span>Đăng ký khám</span>
        </a>
        <a class="nav-link ${currentPage == 'queue' ? 'active' : ''}" href="${pageContext.request.contextPath}/receptionist/queue">
            <i class="bi bi-people"></i><span>Hàng đợi khám</span>
        </a>
        <a class="nav-link ${currentPage == 'billing' ? 'active' : ''}" href="${pageContext.request.contextPath}/receptionist/billing">
            <i class="bi bi-receipt"></i><span>Hóa đơn</span>
        </a>
        <a class="nav-link ${currentPage == 'schedule' ? 'active' : ''}" href="${pageContext.request.contextPath}/receptionist/schedule">
            <i class="bi bi-calendar-check"></i><span>Lịch Trực</span>
        </a>
        <a class="nav-link ${currentPage == 'settings' ? 'active' : ''}" href="${pageContext.request.contextPath}/settings">
            <i class="bi bi-gear"></i><span>Cài đặt</span>
        </a>
    </nav>

    <div class="receptionist-logout">
        <a href="${pageContext.request.contextPath}/logout">
            <i class="bi bi-box-arrow-left"></i><span>Đăng xuất</span>
        </a>
    </div>
</aside>
