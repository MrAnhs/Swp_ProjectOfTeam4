<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>

<aside class="receptionist-sidebar">
    <div class="receptionist-brand">
        <div class="brand-icon"><i class="bi bi-headset"></i></div>
        <div>
            <div class="brand-title">DiabetesCare</div>
        </div>
    </div>

    <!-- Unified Emerald Light Profile Card -->
    <div class="user-profile-sidebar-card" style="cursor: pointer; display: flex !important; flex-direction: column !important; align-items: stretch !important; margin: 12px; padding: 12px 14px; border-radius: 14px; background: rgba(0, 200, 165, 0.08); border: 1px solid rgba(0, 200, 165, 0.25); transition: all 0.25s ease;" onclick="openGlobalEditProfileModal()" role="button" tabindex="0" title="Nhấn để chỉnh sửa thông tin cá nhân">
        <div class="d-flex align-items-center gap-3 mb-2">
            <div class="user-avatar" style="width: 40px; height: 40px; border-radius: 50%; background: #00C8A5; color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.05rem; flex-shrink: 0; box-shadow: 0 4px 10px rgba(0, 200, 165, 0.35);">
                <c:out value="${fn:substring(sessionScope.currentUser.fullName,0,1)}" default="R" />
            </div>
            <div class="user-info" style="min-width: 0; flex: 1;">
                <h6 class="mb-0 fw-bold" style="font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--receptionist-text, #1e293b) !important;"><c:out value="${sessionScope.currentUser.fullName}" default="Lễ tân" /></h6>
                <span class="badge px-2 py-1 mt-1" style="font-size: 0.65rem; font-family: monospace; background: rgba(0, 200, 165, 0.15); color: #007f61; border: 1px solid rgba(0, 200, 165, 0.3);">RECEPTIONIST</span>
            </div>
        </div>
        <div class="d-flex align-items-center justify-content-between pt-2 mt-1 border-top border-secondary border-opacity-25" style="font-size: 0.76rem;">
            <span class="fw-semibold d-flex align-items-center gap-1" style="color: #007f61 !important;"><i class="bi bi-check-circle-fill"></i> Hồ sơ hoàn tất</span>
            <span class="fw-semibold d-flex align-items-center gap-1" style="color: #0284c7 !important;"><i class="bi bi-pencil-square"></i> Chỉnh sửa</span>
        </div>
    </div>

    <nav class="receptionist-nav">
        <a class="nav-link ${currentPage == 'dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/receptionist/dashboard">
            <i class="bi bi-grid-1x2"></i><span>Tổng quan</span>
        </a>
        <a class="nav-link ${currentPage == 'patient-search' ? 'active' : ''}" href="${pageContext.request.contextPath}/receptionist/patients/search">
            <i class="bi bi-search"></i><span>Tìm bệnh nhân</span>
        </a>
        <a class="nav-link ${currentPage == 'patient-register' ? 'active' : ''}" href="${pageContext.request.contextPath}/receptionist/patients/register">
            <i class="bi bi-person-plus"></i><span>Đăng ký bệnh nhân</span>
        </a>
        <a class="nav-link ${currentPage == 'appointment' ? 'active' : ''}" href="${pageContext.request.contextPath}/receptionist/appointments/new">
            <i class="bi bi-calendar2-plus"></i><span>Đăng ký khám</span>
        </a>
        <a class="nav-link ${currentPage == 'queue' ? 'active' : ''}" href="${pageContext.request.contextPath}/receptionist/queue">
            <i class="bi bi-people"></i><span>Hàng đợi khám</span>
        </a>
        <a class="nav-link ${currentPage == 'billing' ? 'active' : ''}" href="${pageContext.request.contextPath}/receptionist/billing">
            <i class="bi bi-receipt"></i><span>Hóa đơn</span>
        </a>
        <a class="nav-link ${currentPage == 'schedule' ? 'active' : ''}" href="${pageContext.request.contextPath}/receptionist/schedule">
            <i class="bi bi-calendar-check"></i><span>Lịch Trực</span>
        </a>
    </nav>
    <div class="receptionist-logout">
        <a href="${pageContext.request.contextPath}/logout">
            <i class="bi bi-box-arrow-left"></i><span>Đăng xuất</span>
        </a>
    </div>
</aside>
<%@ include file="/WEB-INF/views/components/edit-profile-modal.jspf" %>
